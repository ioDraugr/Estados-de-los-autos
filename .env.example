# Configuración del taller para Docker. Copiá este archivo como `.env` (en la
# misma carpeta) y cambiá lo que necesites. Todo es opcional: sin .env se usan
# los defaults de abajo. Después de tocarlo: `docker compose up -d`.
#
# El .env NO se sube a git (puede tener el PIN) y nunca entra en la imagen.

# Puerto de la PC donde queda la app: http://<ip-del-server>:PUERTO
PUERTO=3000

# Zona horaria de los logs del server y del horario de la post-venta por WhatsApp.
TZ=America/Montevideo

# PIN inicial de /admin y /taller. Solo se usa la PRIMERA vez, para sembrarlo
# en la base; después el PIN vive en la base y cambiar esto no hace nada.
ADMIN_PIN=1234

# Cuántas horas sigue en pantalla un auto con todos sus servicios terminados
# antes de ocultarse solo (entero de 1 a 72). Es solo el valor inicial: si se
# cambia desde la configuración de /admin, manda lo guardado en la base.
HORAS_VISIBLE_TERMINADO=4

# Cómo salen los avisos por WhatsApp:
#   baileys → WhatsApp real (el default; necesita internet; ver "Avisos por
#             WhatsApp" en el README). Le escribe a TODOS los autos con celular
#             cargado. La primera vez hay que vincular el celular con el QR.
#   log     → los imprime en los logs del server, NO le escribe a nadie (para
#             probar).
AVISOS_ENVIO=baileys

# Minutos de seguridad entre el cambio y el aviso. Acepta decimales.
AVISOS_DEMORA_MIN=5

# Cada cuántos segundos el server revisa si hay avisos para mandar.
AVISOS_INTERVALO_SEG=30

# En Docker NO se configuran acá (el docker-compose.yml los fija):
#   PORT                → el de adentro es siempre 3000; se cambia PUERTO.
#   DB_PATH             → la base va siempre al volumen de datos.
#   WHATSAPP_SESION_DIR → la sesión de WhatsApp también va al volumen.
#   CARPETA_BACKUPS     → los backups automáticos van siempre a la carpeta
#                         server/data/backups de esta PC. Sin Docker sí se
#                         puede cambiar (por defecto: "backups" al lado de la base).
