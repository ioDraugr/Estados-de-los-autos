# Dependencias
node_modules/

# Builds
client/dist/
server/dist/

# Base de datos local (se regenera sola)
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal

# Sesión de WhatsApp (avisos con AVISOS_ENVIO=baileys): son las CREDENCIALES del
# celular vinculado. Con esos archivos cualquiera manda mensajes como ese número.
# Nunca se suben ni se comparten.
server/data/whatsapp-sesion/

# Logs y sistema
*.log
.DS_Store

# Archivos temporales de Claude Code
.claude/*.tmp.*

# Índice local de CodeGraph
.codegraph/
